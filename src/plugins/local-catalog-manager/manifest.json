{
  "id": "local-catalog-manager",
  "name": "Local Catalog Manager",
  "version": "2.3.0",
  "manifestURI": "https://raw.githubusercontent.com/Carloss616/seanime-extensions/main/src/plugins/local-catalog-manager/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Manage your local-catalog from inside seanime (add/edit/delete) and sync it to a GitHub Gist so the custom-source serves it across devices.",
  "author": "Carloss616",
  "icon": "https://raw.githubusercontent.com/Carloss616/seanime-extensions/main/src/plugins/local-catalog-manager/assets/icon.png",
  "website": "https://github.com/Carloss616/seanime-extensions",
  "readme": "https://github.com/Carloss616/seanime-extensions/blob/main/src/plugins/local-catalog-manager/README.md",
  "lang": "en",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": ["storage", "anilist", "cron"],
      "allow": {
        "networkAccess": {
          "allowedDomains": [
            "api.github.com",
            "github.com",
            "gist.githubusercontent.com"
          ],
          "reasoning": "Store and sync your local catalog in a GitHub Gist, with browser (device-flow) or PAT login."
        }
      }
    }
  },
  "userConfig": {
    "version": 1,
    "requiresConfig": true,
    "fields": [
      {
        "type": "text",
        "name": "githubToken",
        "label": "GitHub token (PAT with the 'gist' scope) — optional fallback if you prefer not to use the in-app 'Connect GitHub' browser login.",
        "default": ""
      },
      {
        "type": "switch",
        "name": "autoSync",
        "label": "Auto-sync: periodically pull the catalog from the Gist",
        "default": "false"
      },
      {
        "type": "text",
        "name": "syncIntervalMinutes",
        "label": "Auto-sync interval (minutes)",
        "default": "30"
      }
    ]
  },
  "payloadURI": "https://raw.githubusercontent.com/Carloss616/seanime-extensions/main/src/plugins/local-catalog-manager/code.js"
}
