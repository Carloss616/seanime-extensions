{
  "id": "manga-source-updates",
  "name": "Manga Source Updates",
  "version": "1.0.0",
  "manifestURI": "https://raw.githubusercontent.com/Carloss616/seanime-extensions/main/src/plugins/manga-source-updates/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Refresh a manga's chapters across providers and list the sources that have new chapters.",
  "author": "Carloss616",
  "icon": "https://raw.githubusercontent.com/Carloss616/seanime-extensions/main/src/plugins/manga-source-updates/assets/icon.png",
  "website": "https://github.com/Carloss616/seanime-extensions",
  "readme": "https://github.com/Carloss616/seanime-extensions/blob/main/src/plugins/manga-source-updates/README.md",
  "lang": "en",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": ["storage", "anilist"],
      "allow": {}
    }
  },
  "userConfig": {
    "version": 1,
    "fields": [
      {
        "type": "text",
        "name": "ttlMinutes",
        "label": "Skip re-checking a manga scanned within N minutes",
        "default": "60"
      },
      {
        "type": "text",
        "name": "farBehindGap",
        "label": "Auto-exclude a source this many chapters behind your progress",
        "default": "10"
      },
      {
        "type": "text",
        "name": "parallelBatch",
        "label": "How many providers to scan in parallel at once",
        "default": "10"
      }
    ]
  },
  "payloadURI": "https://raw.githubusercontent.com/Carloss616/seanime-extensions/main/src/plugins/manga-source-updates/code.js"
}
