{
  "id": "local-catalog",
  "name": "Local Catalog",
  "version": "2.0.0",
  "manifestURI": "https://raw.githubusercontent.com/Carloss616/seanime-extensions/main/src/custom-source/local-catalog/manifest.json",
  "language": "typescript",
  "type": "custom-source",
  "description": "A custom metadata source for manga not on AniList/MangaUpdates. Serves a user-curated catalog (from a URL or inline JSON) so obscure titles appear in your collection and can be read with any installed manga provider.",
  "author": "Carloss616",
  "icon": "https://raw.githubusercontent.com/Carloss616/seanime-extensions/main/src/custom-source/local-catalog/assets/icon.png",
  "website": "https://github.com/Carloss616/seanime-extensions",
  "readme": "https://github.com/Carloss616/seanime-extensions/blob/main/src/custom-source/local-catalog/README.md",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/Carloss616/seanime-extensions/main/src/custom-source/local-catalog/code.js",
  "userConfig": {
    "requiresConfig": true,
    "version": 1,
    "fields": [
      {
        "name": "catalogUrl",
        "label": "Catalog URL — public raw JSON (gist/repo raw, or http://localhost:8000/catalog.json). No token",
        "type": "text",
        "default": ""
      },
      {
        "name": "catalog",
        "label": "Inline catalog JSON (used when Catalog URL is empty). The default below is an editable example — replace it with your own entries (full field list in the README).",
        "type": "text",
        "default": "{\"version\":2,\"manga\":[{\"id\":1,\"type\":\"MANGA\",\"title\":{\"userPreferred\":\"Example Title\",\"english\":\"Example Title\"},\"synonyms\":[\"alternate title\"],\"genres\":[\"Action\"],\"status\":\"RELEASING\",\"format\":\"MANGA\",\"chapters\":120,\"coverImage\":{\"extraLarge\":\"https://example.com/cover.jpg\"},\"startDate\":{\"year\":2024}}]}"
      },
      {
        "name": "cacheMinutes",
        "label": "Cache minutes (0 disables caching)",
        "type": "text",
        "default": "10"
      }
    ]
  }
}
