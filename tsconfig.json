{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2018"],
    "types": [],
    "esModuleInterop": true,
    "isolatedModules": false
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
