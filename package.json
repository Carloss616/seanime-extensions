{
  "name": "seanime-extensions",
  "module": "build.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run scripts/build.ts",
    "icon": "bun run scripts/svg2png.ts",
    "sync:types": "bun run scripts/sync-types.ts",
    "postbuild": "bun run check:fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "check": "biome check .",
    "check:fix": "biome check . --write --unsafe",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14"
}
